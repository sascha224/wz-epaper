# ==== Walsroder Zeitung / plenigo Zugang ====
WZ_USERNAME=deine-email@example.de
WZ_PASSWORD=dein-passwort

# Wo die Browser-Session gecacht wird (spart taegliches Neu-Einloggen).
# Standard: state.json neben dem Script.
WZ_STATE_FILE=/opt/wz-epaper/state.json

# Optionale lokale Kopie. Leer lassen = keine lokale Datei, nur Nextcloud.
WZ_LOCAL_DIR=/var/lib/wz-epaper/pdf

# Retry, falls die Ausgabe frueh morgens noch nicht online ist
WZ_RETRIES=6
WZ_RETRY_WAIT=600

# ==== Nextcloud (WebDAV) ====
# Basis-URL bis einschliesslich deines Benutzernamens:
NC_WEBDAV_URL=https://cloud.example.de/remote.php/dav/files/sascha
NC_USERNAME=sascha
# App-Passwort verwenden! Nextcloud: Einstellungen -> Sicherheit -> "App-Passwort erstellen"
NC_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
# Zielordner in der Nextcloud. {year} und {month} werden ersetzt.
NC_TARGET_DIR=Walsroder Zeitung/{year}
